---
import { Image } from "astro:assets";
import myImage from "../images/avatar.png";
import deltaruneLogo from "../images/deltarune-logo.png";
import undertaleLogo from "../images/undertale-logo.png";
import styles from '../styles/SobreMi.module.css';
import DiscordPresence from './DiscordPresence.jsx';
---
<style>
  @import '../styles/SobreMi.module.css';
</style>
<section
  id="sobre-mi"
  class="min-h-screen flex items-center justify-center px-6 py-20 relative overflow-hidden"
>
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-10 left-10 w-20 h-20 border border-neutral-600 rotate-45"></div>
    <div class="absolute top-32 right-20 w-16 h-16 border border-neutral-700 rotate-12"></div>
    <div class="absolute bottom-20 left-1/4 w-12 h-12 border border-neutral-600 rotate-45"></div>
    <div class="absolute bottom-40 right-10 w-24 h-24 border border-neutral-700 -rotate-12"></div>
    <div class="absolute top-1/2 left-1/3 w-8 h-8 bg-neutral-800 rotate-45"></div>
    <div class="absolute top-1/4 right-1/3 w-6 h-6 bg-neutral-700 rotate-12"></div>
  </div>
  <div class="max-w-6xl mx-auto z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-6 lg:order-1">
        <div>
          <h1 class="text-5xl font-bold mb-4">
            <span
              class="bg-gradient-to-r from-neutral-100 via-neutral-300 to-neutral-100 bg-clip-text text-transparent inline-block align-baseline"
            >
              itzrauh
            </span>
          </h1>
          <div class="w-20 h-1 bg-gradient-to-r from-neutral-600 to-neutral-400 rounded-full" />
        </div>

        <div class="space-y-4">
              <h2 class="text-2xl font-semibold text-neutral-200">
                Desarrollador
              </h2>
              <p class="text-lg text-neutral-400 leading-relaxed">
                ¡Hola! Soy un desarrollador apasionado por la programación,
                especialmente en{" "}
                <span class="inline-flex items-baseline gap-1 text-orange-400 font-medium">
                  <svg
                    class="w-5 h-5 flex-shrink-0 notransform"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M8.851 18.56s-.917.534.653.714c1.902.218 2.874.187 4.969-.211 0 0 .552.346 1.321.646-4.699 2.013-10.633-.118-6.943-1.149M8.276 15.933s-1.028.761.542.924c2.032.209 3.636.227 6.413-.308 0 0 .384.389.987.602-5.679 1.661-12.007.13-7.942-1.218M13.116 11.475c1.158 1.333-.304 2.533-.304 2.533s2.939-1.518 1.589-3.418c-1.261-1.772-2.228-2.652 3.007-5.688 0-.001-8.216 2.051-4.292 6.573M19.33 20.504s.679.559-.747.991c-2.712.822-11.288 1.069-13.669.033-.856-.373.75-.89 1.254-.998.527-.114.828-.93.828-.93-.953.671-6.156 1.317-2.643 1.887 9.58 1.553 17.462-.7 14.977-1.983M9.292 13.21s-4.362 1.036-1.544 1.412c1.189.159 3.561.123 5.77-.062 1.806-.152 3.618-.477 3.618-.477s-.637.272-1.098.587c-4.429 1.165-12.986.623-10.522-.568 2.082-1.006 3.776-.892 3.776-.892M17.116 17.584c4.503-2.34 2.421-4.589.968-4.285-.355.074-.515.138-.515.138s.132-.207.385-.297c2.875-1.011 5.086 2.981-.928 4.562 0-.001.07-.062.09-.118M14.401 0s2.494 2.494-2.365 6.33c-3.896 3.077-.888 4.832-.001 6.836-2.274-2.053-3.943-3.858-2.824-5.539 1.644-2.469 6.197-3.665 5.19-7.627M9.734 23.924c4.322.277 10.959-.153 11.116-2.198 0 0-.302.775-3.572 1.391-3.688.694-8.239.613-10.937.168 0-.001.553.457 3.393.639" />
                  </svg>
                  Java{" "}
                </span>{" "}
                para crear plugins/mods de Minecraft y{" "}
                <span class="inline-flex items-baseline gap-1 text-yellow-400 font-medium">
                  <svg
                    class="w-5 h-5 flex-shrink-0 notransform"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M0 0h24v24H0V0zm22.034 18.276c-.175-1.095-.888-2.015-3.003-2.873-.736-.345-1.554-.585-1.797-1.14-.091-.33-.105-.51-.046-.705.15-.646.915-.84 1.515-.66.39.12.75.42.976.9 1.034-.676 1.034-.676 1.755-1.125-.27-.42-.404-.601-.586-.78-.63-.705-1.469-1.065-2.834-1.034l-.705.089c-.676.165-1.32.525-1.71 1.005-1.14 1.291-.811 3.541.569 4.471 1.365 1.02 3.361 1.244 3.616 2.205.24 1.17-.87 1.545-1.966 1.41-.811-.18-1.26-.586-1.755-1.336l-1.83 1.051c.21.48.45.689.81 1.109 1.74 1.756 6.09 1.666 6.871-1.004.029-.09.24-.705.074-1.65l.046.067zm-8.983-7.245h-2.248c0 1.938-.009 3.864-.009 5.805 0 1.232.063 2.363-.138 2.711-.33.689-1.18.601-1.566.48-.396-.196-.597-.466-.83-.855-.063-.105-.11-.196-.127-.196l-1.825 1.125c.305.63.75 1.172 1.324 1.517.855.51 2.004.675 3.207.405.783-.226 1.458-.691 1.811-1.411.51-.93.402-2.07.397-3.346.012-2.054 0-4.109 0-6.179l.004-.056z" />
                  </svg>
                  JavaScript{" "}
                </span>{" "}
                para launchers / otras aplicaciones. Me gusta mucho programar,
                aprender nuevas tecnologías y jugar videojuegos.
              </p>
              <p class="text-neutral-400 leading-relaxed">
                Y estos son los juegos que más me gustan{" "}
                <span class="inline-flex items-baseline gap-1 text-white font-medium">
                  <Image
                    src={deltaruneLogo}
                    alt="Deltarune"
                    class="w-5 h-5 flex-shrink-0 games"
                  />
                  Deltarune
                </span>{" "}
                y{" "}
                <span class="inline-flex items-baseline gap-1 text-red-400 font-medium">
                  <Image
                    src={undertaleLogo}
                    alt="Undertale"
                    class="w-5 h-5 flex-shrink-0 games"
                  />
                  Undertale
                </span>, estos juegos desde que los conozco me encantan. Sobre todo
                Deltarune, que es mi juego favorito.
              </p>
              <p class="text-neutral-400 leading-relaxed">
                Algo que me encanta mucho también es escuchar música. Tengo una
                gran variedad de géneros musicales en mis playlists, en el mini
                reproductor que está en la parte inferior derecha puedes ver
                canciones que me gustan.
              </p>
              <p class="text-neutral-500">
                También hago streaming en{" "}
                <span class="inline-flex items-baseline gap-1 text-purple-500 font-medium">
                  <svg
                    class="w-5 h-5 flex-shrink-0 notransform"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z" />
                  </svg>
                  Twitch
                </span>{" "}
                donde juego eventos de Minecraft y otros juegos, antes era mucho
                más activo.
              </p>
            </div>

        <div class="grid grid-cols-3 gap-6">
          <div class="text-center">
            <div
              class="text-3xl font-bold bg-gradient-to-br from-neutral-100 to-neutral-400 bg-clip-text text-transparent inline-block align-baseline"
            >
              ~2
            </div>
            <div class="text-sm text-neutral-500 uppercase tracking-wider">
              Años Programando
            </div>
          </div>
          <div class="text-center">
            <div
              class="text-3xl font-bold bg-gradient-to-br from-neutral-100 to-neutral-400 bg-clip-text text-transparent inline-block align-baseline"
            >
              10+
            </div>
            <div class="text-sm text-neutral-500 uppercase tracking-wider">
              Proyectos
            </div>
          </div>
          <div class="text-center">
            <div
              class="text-3xl font-bold bg-gradient-to-br from-neutral-100 to-neutral-400 bg-clip-text text-transparent inline-block align-baseline"
            >
              ∞
            </div>
            <div class="text-sm text-neutral-500 uppercase tracking-wider">
              Gaming
            </div>
          </div>
        </div>

        <div>
          <button
            onclick="document.getElementById('contacto')?.scrollIntoView({ behavior: 'smooth' })"
            class="group inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-neutral-800 bg-neutral-950/80 backdrop-blur-sm text-neutral-100 font-medium transition-all duration-200 hover:bg-neutral-900/80 hover:border-neutral-700 hover:scale-[1.02] active:scale-[0.98]"
          >
            <span>Hablemos</span>
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </button>
        </div>
      </div>

      <div class="flex flex-col items-center gap-6 lg:order-2">
        <div class="relative group">
            <Image src={myImage} alt="itzrauh" class="w-80 h-80 rounded-full bg-gradient-to-br from-neutral-800 via-neutral-700 to-neutral-600 p-1" />
        </div>
        <DiscordPresence client:load />
      </div>
    </div>
  </div>
</section>
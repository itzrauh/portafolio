---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Base64 Encoder/Decoder - itzrauh Tools" description="Codifica y decodifica texto en Base64 de manera rápida y sencilla">
  <main transition:name="main-content" class="pt-20 px-6 py-20">
    <nav class="fixed top-0 left-0 right-0 z-50">
      <div class="flex justify-between items-center p-6">
        <div class="flex items-center gap-4">
          <a href="/tools" class="flex items-center gap-2 text-neutral-400 hover:text-neutral-300 transition-all duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Tools
          </a>
          <span class="text-neutral-600">/</span>
          <span class="text-neutral-100 font-medium">Base64</span>
        </div>
        
        <div class="flex items-center gap-4">
          <a href="/" class="text-neutral-400 hover:text-neutral-300 transition-colors duration-200">
            Inicio
          </a>
          <a href="/tools" class="text-neutral-400 hover:text-neutral-300 transition-colors duration-200">
            Tools
          </a>
        </div>
      </div>
    </nav>
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <div class="flex items-center justify-center gap-3 mb-4">
            <div class="p-3 rounded-lg bg-gradient-to-br from-blue-500/20 to-blue-700/20 border border-blue-500/30">
              <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            </div>
          </div>
          <h1 class="text-4xl font-bold mb-4">
            <span class="bg-gradient-to-r from-neutral-100 via-neutral-300 to-neutral-100 bg-clip-text text-transparent">
              Base64 Encoder/Decoder
            </span>
          </h1>
          <div class="w-20 h-1 bg-gradient-to-r from-blue-500 to-blue-400 rounded-full mx-auto no-cursor" />
          <p class="text-neutral-400 mt-6 max-w-2xl mx-auto" style="padding-bottom: 2rem;">
            Codifica y decodifica texto en Base64 de manera rápida y sencilla. Perfecto para desarrollo y debugging.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
          <div class="rounded-xl border border-neutral-800 bg-neutral-950/50 backdrop-blur-sm p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="p-2 rounded-lg bg-gradient-to-br from-green-500/20 to-green-700/20 border border-green-500/30">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-neutral-100">Encode</h3>
            </div>
            
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-neutral-300 mb-2">
                  Texto a codificar:
                </label>
                <textarea
                  id="textInput"
                  placeholder="Escribe aquí el texto que quieres codificar en Base64..."
                  class="yescursor w-full h-32 px-4 py-3 rounded-lg border border-neutral-700 bg-neutral-900/50 text-neutral-100 placeholder-neutral-500 resize-none focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 transition-colors"
                ></textarea>
              </div>
              
              <button
                id="encodeBtn"
                class="w-full px-4 py-2 rounded-lg border border-green-600 bg-green-600/20 text-green-300 font-medium transition-all duration-200 hover:bg-green-600/30 hover:border-green-500 hover:scale-[1.02] active:scale-[0.98]"
              >
                <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                Codificar a Base64
              </button>
            </div>
          </div>

          <div class="rounded-xl border border-neutral-800 bg-neutral-950/50 backdrop-blur-sm p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="p-2 rounded-lg bg-gradient-to-br from-orange-500/20 to-orange-700/20 border border-orange-500/30">
                <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-neutral-100">Decode</h3>
            </div>
            
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-neutral-300 mb-2">
                  Base64 a decodificar:
                </label>
                <textarea
                  id="base64Input"
                  placeholder="Pega aquí el texto en Base64 que quieres decodificar..."
                  class="yescursor w-full h-32 px-4 py-3 rounded-lg border border-neutral-700 bg-neutral-900/50 text-neutral-100 placeholder-neutral-500 resize-none focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500 transition-colors"
                ></textarea>
              </div>
              
              <button
                id="decodeBtn"
                class="w-full px-4 py-2 rounded-lg border border-orange-600 bg-orange-600/20 text-orange-300 font-medium transition-all duration-200 hover:bg-orange-600/30 hover:border-orange-500 hover:scale-[1.02] active:scale-[0.98]"
              >
                <svg class="w-4 h-4 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"/>
                </svg>
                Decodificar Base64
              </button>
            </div>
          </div>
        </div>

        <div class="mb-8">
          <div class="rounded-xl border border-neutral-800 bg-neutral-950/50 backdrop-blur-sm p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-semibold text-neutral-100">Resultado</h3>
              <button
                id="copyBtn"
                class="px-3 py-1 text-sm rounded-lg border border-neutral-700 bg-neutral-900/50 text-neutral-300 font-medium transition-all duration-200 hover:bg-neutral-800/50 hover:border-neutral-600 disabled:opacity-50 disabled:cursor-not-allowed"
                disabled
              >
                <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
                </svg>
                Copiar
              </button>
            </div>
            
            <div class="relative">
              <textarea
                id="resultOutput"
                readonly
                placeholder="El resultado aparecerá aquí..."
                class="yescursor w-full h-32 px-4 py-3 rounded-lg border border-neutral-700 bg-neutral-900/30 text-neutral-100 placeholder-neutral-500 resize-none focus:border-neutral-600 focus:outline-none transition-colors"
              ></textarea>
              <div id="resultStatus" class="absolute top-2 right-2 hidden">
                <span class="px-2 py-1 text-xs rounded-full bg-green-500/20 text-green-400 border border-green-500/30">
                  ✓ Copiado
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-xl border border-neutral-800 bg-neutral-950/30 backdrop-blur-sm p-6">
            <h4 class="text-lg font-semibold text-neutral-100 mb-3">¿Qué es Base64?</h4>
            <p class="text-neutral-400 text-sm leading-relaxed">
              Base64 es un sistema de codificación que convierte datos binarios en texto ASCII. 
              Se usa comúnmente para transmitir datos a través de medios que están diseñados para texto, 
              como email o URLs.
            </p>
          </div>
          
          <div class="rounded-xl border border-neutral-800 bg-neutral-950/30 backdrop-blur-sm p-6">
            <h4 class="text-lg font-semibold text-neutral-100 mb-3">Casos de Uso</h4>
            <ul class="text-neutral-400 text-sm space-y-1">
              <li>• Codificación de datos para URLs</li>
              <li>• Transmisión de imágenes en JSON</li>
              <li>• Autenticación básica HTTP</li>
              <li>• Almacenamiento de datos binarios</li>
            </ul>
          </div>
        </div>
      </div>
    </main>

    <script>
      const textInput = document.getElementById('textInput');
      const base64Input = document.getElementById('base64Input');
      const resultOutput = document.getElementById('resultOutput');
      const encodeBtn = document.getElementById('encodeBtn');
      const decodeBtn = document.getElementById('decodeBtn');
      const copyBtn = document.getElementById('copyBtn');
      const resultStatus = document.getElementById('resultStatus');

      if (encodeBtn) {
        encodeBtn.addEventListener('click', () => {
          const text = textInput.value.trim();
          if (!text) {
            resultOutput.value = '';
            copyBtn.disabled = true;
            return;
          }

          try {
            const encoded = btoa(unescape(encodeURIComponent(text)));
            resultOutput.value = encoded;
            copyBtn.disabled = false;

            // Clear the decode input
            base64Input.value = '';
          } catch (error) {
            resultOutput.value = 'Error: No se pudo codificar el texto';
            copyBtn.disabled = true;
          }
        });
      }

      if (decodeBtn) {
        decodeBtn.addEventListener('click', () => {
          const base64Text = base64Input.value.trim();
          if (!base64Text) {
            resultOutput.value = '';
            copyBtn.disabled = true;
            return;
          }

          try {
            const decoded = decodeURIComponent(escape(atob(base64Text)));
            resultOutput.value = decoded;
            copyBtn.disabled = false;

            // Clear the encode input
            textInput.value = '';
          } catch (error) {
            resultOutput.value = 'Error: Base64 inválido o malformado';
            copyBtn.disabled = true;
          }
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const text = resultOutput.value;
          if (!text) return;

          try {
            await navigator.clipboard.writeText(text);
            
            // Show success indicator
            if (resultStatus) {
              resultStatus.classList.remove('hidden');
              setTimeout(() => {
                resultStatus.classList.add('hidden');
              }, 2000);
            }
          } catch (error) {
            // Fallback for older browsers
            resultOutput.select();
            document.execCommand('copy');
            if (resultStatus) {
              resultStatus.classList.remove('hidden');
              setTimeout(() => {
                resultStatus.classList.add('hidden');
              }, 2000);
            }
          }
        });
      }

      if (textInput) {
        textInput.addEventListener('input', () => {
          if (textInput.value.trim()) {
            base64Input.value = '';
          }

          if (!textInput.value.trim() && !base64Input.value.trim()) {
            resultOutput.value = '';
            copyBtn.disabled = true;
          }
        });
      }

      if (base64Input) {
        base64Input.addEventListener('input', () => {
          if (base64Input.value.trim()) {
            textInput.value = '';
          }

          if (!base64Input.value.trim() && !textInput.value.trim()) {
            resultOutput.value = '';
            copyBtn.disabled = true;
          }
        });
      }

      if (textInput) {
        textInput.addEventListener('keydown', (e) => {
          if (e.ctrlKey && e.key === 'Enter') {
            if (encodeBtn) {
              encodeBtn.click();
            }
          }
        });
      }

      if (base64Input) {
        base64Input.addEventListener('keydown', (e) => {
          if (e.ctrlKey && e.key === 'Enter') {
            if (decodeBtn) {
              decodeBtn.click();
            }
          }
        });
      }
    </script>
  </main>
</BaseLayout>
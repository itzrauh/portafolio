---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.jsx';
import SobreMi from '../components/SobreMi.astro';
import Experiencias from '../components/Experiencias.astro';
import Habilidades from '../components/Habilidades.jsx';
import Contacto from '../components/Contacto.jsx';
import Footer from '../components/Footer.jsx';
import SpeedInsights  from "@vercel/speed-insights/astro"
---

<BaseLayout title="itzrauh - Portfolio" description="itzrauh">
  <main transition:name="main-content">
    <Navigation client:load/>
    <div class="relative">
      
      <SobreMi />
      <Experiencias/>
      <Habilidades client:load />
      <Contacto client:load/>
      <Footer />
    </div>
  </main>
  <SpeedInsights/>
</BaseLayout>
